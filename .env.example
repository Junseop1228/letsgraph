# Copy this file to .env.local and fill in the values. Never commit .env.local or paste keys in chat.

# Data source: "fixtures" (default, demo data, no keys needed) or "supabase" (after migrating and seeding the DB)
DATA_SOURCE=fixtures

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only key for AI results, orders/passes and the collector (never exposed to the browser)
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# OpenDART (opendart.fss.or.kr) authentication key
DART_API_KEY=your-dart-key

# Gemini API key (billing-enabled Google Cloud project), read by @ai-sdk/google
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
# Optional model override (default gemini-2.5-flash)
GEMINI_MODEL=

# Toss Payments TEST keys (developers.tosspayments.com > API 개별 연동 키)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your-client-key
TOSS_SECRET_KEY=test_sk_your-secret-key
