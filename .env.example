# Copy this file to .env.local and fill in the values. Never commit .env.local or paste keys in chat.
# Leave a value EMPTY until you have the real one: a placeholder like "your-key" counts as "set" and breaks the app
# (e.g. a non-URL Supabase value makes every request fail with "Invalid supabaseUrl").
# Ask the team where to get shared values (Supabase/Google Cloud member invite or a password manager), not a chat room.

# Data source: "fixtures" (default, demo data, no keys needed) or "supabase" (after db:push and seeding, see README)
DATA_SOURCE=fixtures

# Supabase (Project Settings > API Keys / Data API)
# URL format: https://<project-id>.supabase.co  (NOT the dashboard address supabase.com/dashboard/project/...)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key: starts with sb_publishable_ (legacy projects: the anon key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: starts with sb_secret_ (legacy: service_role). Server-only, full DB access. Never share in chat.
SUPABASE_SECRET_KEY=
# Database password (Project Settings > Database). Only used by the Supabase CLI (db:link, db:push, migration list).
SUPABASE_DB_PASSWORD=

# Demo data loader: any long random string you choose. Needed for POST /api/dev/seed (header x-seed-token).
SEED_TOKEN=

# OpenDART (opendart.fss.or.kr) authentication key
DART_API_KEY=

# Gemini API key from Google AI Studio, created in the team's billing-enabled Google Cloud project
# (free-tier keys may use inputs to improve Google products: do not send real user data with them).
# Prefer one key per teammate in the same project (IAM member) so usage is traceable and a leaked key can be revoked alone.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override; leave empty for the default (gemini-3.8-flash). gemini-2.5-flash is no longer offered to new projects.
GEMINI_MODEL=

# Toss Payments TEST keys: developers.tosspayments.com > API 키 > "API 개별 연동 키" (test_ck_ / test_sk_).
# NOT the 결제위젯 연동 키 (test_gck_ / test_gsk_): this app opens the payment window with payment(), not widgets.
# Without 전자결제 신청 the developer center shows the public docs example keys; they work for test payments.
# Client key (test_ck_) is sent to the browser; the secret key (test_sk_) must never go in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# PostHog (optional; measurement is off when empty). No personal data is sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# 관리자 (specs/data-pipeline FR-OPS-04): comma-separated e-mails that see the 관리자 menu, e.g. a@x.com,b@y.com
ADMIN_EMAILS=
